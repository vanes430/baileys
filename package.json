{
  "name": "baileys",
  "type": "module",
  "version": "7.0.0-rc.9",
  "description": "A WebSockets library for interacting with WhatsApp Web",
  "keywords": [
    "whatsapp",
    "automation"
  ],
  "homepage": "https://github.com/vanes430/baileys",
  "repository": {
    "url": "git+https://github.com/vanes430/baileys.git"
  },
  "license": "MIT",
  "author": "vanes430 <vanessimbolon2020@gmail.com>",
  "main": "lib/index.js",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "preinstall": "bun run --smol ./engine-requirements.js",
    "update-proto": "bun run ./WAProto/extract.js && bun run compile-proto",
    "compile-proto": "bunx pbjs -t static-module -w commonjs -o ./WAProto/index.js ./WAProto/WAProto.proto && bunx pbts -o ./WAProto/index.d.ts ./WAProto/index.js"
  },
  "devDependencies": {
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "protobufjs-cli": "^1.1.3"
  },
  "dependencies": {
    "@cacheable/node-cache": "^2.0.1",
    "@hapi/boom": "^10.0.1",
    "async-mutex": "^0.5.0",
    "libsignal": "github:whiskeysockets/libsignal-node",
    "lru-cache": "^11.2.6",
    "music-metadata": "^11.2.0",
    "p-queue": "^9.1.0",
    "pino": "^9.6",
    "protobufjs": "^7.4.0",
    "whatsapp-rust-bridge": "0.5.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.2.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^4.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  }
}